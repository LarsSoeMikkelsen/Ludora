[Unit]
Description=Ludora first-boot snapper and grub-btrfs setup
After=local-fs.target
# Written only when the whole setup succeeded; a failed run is retried on the
# next boot.
ConditionPathExists=!/var/lib/ludora/snapper-setup.done

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/bin/ludora-snapper-setup.sh

[Install]
WantedBy=multi-user.target
