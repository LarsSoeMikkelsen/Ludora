<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Ludora</vendor>
  <vendor_url>https://ludora.org</vendor_url>
  <action id="org.ludora.game-mode.set-session">
    <description>Switch between the desktop and Game Mode</description>
    <message>Switching between the desktop and Game Mode</message>
    <icon_name>input-gaming</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ludora-game-mode/set-session</annotate>
  </action>
</policyconfig>
